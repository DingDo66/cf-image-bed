{
  "name": "cf-image-bed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "极简、自部署的 Cloudflare Workers 图床",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test tests/api.test.mjs tests/selection.test.mjs tests/media.test.mjs tests/deploy-config.test.mjs",
    "test:selection": "node --experimental-strip-types --test tests/selection.test.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "heic-to": "^1.5.2",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
